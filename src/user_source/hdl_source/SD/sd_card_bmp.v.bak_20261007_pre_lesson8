
// =============================================================================
// sd_card_bmp —— TF(FAT32) 图片轮播 + SDRAM 双缓冲 + HDMI 显示控制
//
// 本文件当前状态：第三讲（按键/轮播）+ 第六讲（复位与启动门控）
//               + 第七讲（FAT32 最小改动移植）
//               + 第五讲（系统稳定性 5 项必做，迁移到 FAT32 生效路径）
//
// 第五讲迁移说明：
//   第五讲原文把 5 项必做优化加在 bmp_read.v（裸扇区扫描版）中；第七讲已按讲义
//   要求删除 bmp_read 实例，因此本文件把第五讲的“校验/错误码/超时/像素完整性/
//   重试跳过”逐条落在当前生效的 FAT32 字节流路径上，校验条件与错误码与讲义一致。
//   - 2.1 BMP 严格校验（含官方原有 4 项 + 讲义新增 5 项）
//   - 2.2 错误码上报与恢复（ERR_NONE/ERR_HEADER/ERR_TIMEOUT/ERR_TRUNCATED）
//   - 2.3 坏图跳过：FAT32 下由“目录项文件名匹配 + 校验失败后屏蔽该槽位”实现
//   - 2.4 加载超时（SD_READ_TIMEOUT_MS，默认 500ms，按“无进展”计时）
//   - 2.5 像素完整性校验（EXPECTED_PIXELS=307200）
//   - 2.2 恢复策略：重试 1 次 → 屏蔽坏图 → 切下一张 → 保留上一帧不花屏
//
// 数码管读数（state_code，只有第 6 位点亮）：
//   0 = SD 未初始化；1~4 = 当前显示 PIC1~PIC4；
//   9 = ERR_HEADER；A = ERR_TIMEOUT；B = ERR_TRUNCATED；
//   C = ERR_NO_IMAGE（根目录没有 PICn.BMP）；D = ERR_FS（卷/BPB 不认识）；
//   E = ERR_SD_SECTOR（SD 扇区读失败）。错误码显示为 8|错误码。
// =============================================================================

module sd_card_bmp #(
    parameter integer CLK_FREQ_HZ       = 100_000_000,
    parameter [31:0]  SCAN_START_SECTOR = 32'd0,
    parameter [31:0]  SCAN_MAX_SECTOR   = 32'd131071,
    parameter [2:0]   SCAN_TARGET_COUNT = 3'd4,
    parameter integer LONG_PRESS_MS     = 1000,
    parameter integer AUTO_PLAY_MS      = 3000,
    // ===== 第五讲 2.6 参数集中化（稳定性参数）=====
    parameter integer SD_READ_TIMEOUT_MS = 500,   // 加载/扫描无进展超时
    parameter [1:0]   MAX_RETRIES        = 2'd1,  // 失败后重试 1 次
    // 图像参数：必须与顶层传入的 bmp_width/bmp_height 一致
    parameter integer BMP_WIDTH_P        = 640,
    parameter integer BMP_HEIGHT_P       = 480
)(
    input                       clk,
    input                       rst,
    input                       key_next,
    input                       key_auto,
    output reg [3:0]            state_code,
    input  [15:0]               bmp_width,
    input  [15:0]               bmp_height,
    input                       sdram_init_done,
    output reg                  display_valid,

    input                       write_finish_toggle,
    output reg [1:0]            write_buf_idx,
    output reg [1:0]            disp_buf_idx,

    output                      write_req,
    input                       write_req_ack,
    output                      write_en,
    output [31:0]               write_data,
    output                      SD_nCS,
    output                      SD_DCLK,
    output                      SD_MOSI,
    input                       SD_MISO
);

// ---------------------------------------------------------------------------
// 第五讲 2.2：错误码定义
// ---------------------------------------------------------------------------
localparam [2:0] ERR_NONE      = 3'd0;   // 无错误
localparam [2:0] ERR_HEADER    = 3'd1;   // BMP 头校验失败
localparam [2:0] ERR_TIMEOUT   = 3'd2;   // SD 读取/写入超时
localparam [2:0] ERR_TRUNCATED = 3'd3;   // 像素数据截断（不完整）
localparam [2:0] ERR_NO_IMAGE  = 3'd4;   // 卷解析成功，但根目录没有 PIC1~4.BMP
localparam [2:0] ERR_FS        = 3'd5;   // 卷/BPB 不认识（MBR 类型或 BPB 校验失败）
localparam [2:0] ERR_SD_SECTOR = 3'd6;   // SD 扇区读取失败

// 第五讲 2.5：期望像素数 / 对应字节数
localparam [31:0] EXPECTED_PIXELS = BMP_WIDTH_P * BMP_HEIGHT_P;   // 640*480 = 307200
localparam [31:0] EXPECTED_BYTES  = EXPECTED_PIXELS * 32'd3;      // 921600

// 第五讲 2.4：超时阈值（无进展时钟周期数）
localparam integer WATCHDOG_CYCLES   = (CLK_FREQ_HZ / 1000) * SD_READ_TIMEOUT_MS;
localparam integer LONG_PRESS_CYCLES = (CLK_FREQ_HZ / 1000) * LONG_PRESS_MS;
localparam integer AUTO_PLAY_CYCLES  = (CLK_FREQ_HZ / 1000) * AUTO_PLAY_MS;

wire key_next_press;
wire key_next_stable;
wire key_auto_press;
wire key_auto_stable;
wire key_auto_release;

wire             sd_sec_read;
wire [31:0]      sd_sec_read_addr;
wire [7:0]       sd_sec_read_data;
wire             sd_sec_read_data_valid;
wire             sd_sec_read_end;
wire             bmp_data_wr_en;
wire [23:0]      bmp_data;
wire             sd_init_done;
wire             file_done;
wire             scanner_done_pulse;
reg              scan_done_latched;
wire             scan_done = scan_done_latched;

// FAT32 lesson 7 sector contracts and filesystem metadata.
reg              use_streamer;
wire [7:0]       scanner_spc;
wire [31:0]      scanner_fat_start;
wire [31:0]      scanner_data_start;
wire [31:0]      scanner_max_cluster;
wire [3:0]       scan_resource_valid;
reg  [31:0]      img_cluster0;
reg  [31:0]      img_cluster1;
reg  [31:0]      img_cluster2;
reg  [31:0]      img_cluster3;
reg  [31:0]      img_size0;
reg  [31:0]      img_size1;
reg  [31:0]      img_size2;
reg  [31:0]      img_size3;
wire [31:0]      scanner_cluster0;
wire [31:0]      scanner_cluster1;
wire [31:0]      scanner_cluster2;
wire [31:0]      scanner_cluster3;
wire [31:0]      scanner_size0;
wire [31:0]      scanner_size1;
wire [31:0]      scanner_size2;
wire [31:0]      scanner_size3;
reg  [31:0]      load_cluster;
reg  [31:0]      load_file_size;

wire             scanner_sector_req;
wire [31:0]      scanner_sector_lba;
wire             scanner_sector_busy;
wire             scanner_sector_valid;
wire [7:0]       scanner_sector_byte;
wire [8:0]       scanner_sector_byte_index;
wire             scanner_sector_done;
wire [7:0]       scanner_sector_error;
wire             streamer_sector_req;
wire [31:0]      streamer_sector_lba;
wire             streamer_sector_busy;
wire             streamer_sector_valid;
wire [7:0]       streamer_sector_byte;
wire [8:0]       streamer_sector_byte_index;
wire             streamer_sector_done;
wire [7:0]       streamer_sector_error;
reg              arb_sector_req;
reg  [31:0]      arb_sector_lba;
wire             arb_sector_busy;
wire             arb_sector_valid;
wire [7:0]       arb_sector_byte;
wire [8:0]       arb_sector_byte_index;
wire             arb_sector_done;
wire [7:0]       arb_sector_error;

wire             streamer_byte_valid;
wire [7:0]       streamer_byte;
wire [31:0]      streamer_byte_offset;
wire             streamer_busy;
wire [7:0]       scanner_fs_error;
wire [7:0]       streamer_fs_error;
reg              file_start_pulse;
reg              write_req_reg;

reg              scan_start_pulse;
reg              load_start_pulse;
reg              scan_kicked;
reg              first_image_committed;
reg              auto_play_en;
reg [31:0]       auto_cnt;
reg [1:0]        img_idx;              // 当前真正显示中的图片槽位（PIC 编号-1）
reg [1:0]        load_idx;             // 当前正在写入的图片槽位
reg [1:0]        pending_buf_idx;      // 当前正在写入的目标缓冲区
reg              next_req_pending;
reg              prev_req_pending;
reg              load_busy;
reg              write_finish_seen;

reg              key_auto_stable_d;
reg [31:0]       long_press_cnt;
reg              long_press_marked;

// bmp_ready 先表示“源文件读取/送 FIFO 完成”；真正切显示要等 write_finish_toggle 同步后
reg              source_done_seen;

// ---------------------------------------------------------------------------
// 第五讲 2.1/2.2/2.4/2.5：校验、错误上报、超时、像素完整性相关寄存器
// ---------------------------------------------------------------------------
reg [3:0]        img_bad;              // 已确认损坏/无法加载的槽位（屏蔽用）
reg [1:0]        retry_count;          // 当前这一张已重试次数
reg              retry_pending;        // 需要重试同一张
reg              skip_pending;         // 需要跳过坏图、切下一张可用图
reg              load_abort;           // 当前这次加载已判定失败
reg [2:0]        bmp_error;            // 错误码（保持到下一次扫描/成功提交）
reg              load_error;           // 加载失败单周期脉冲（第五讲 2.2）
reg              err_latched;          // 错误码显示锁存
reg [31:0]       pixel_count;          // 第五讲 2.5：已写入 FIFO 的像素数
reg [31:0]       wd_cnt;               // 第五讲 2.4：无进展计时
reg              wd_latched;           // 超时锁存（供恢复阶梯使用）
reg              file_done_d1;         // 源文件读完打一拍（等像素计数稳定）

// BMP file stream to RGB pixel conversion.
reg [1:0]        bmp_stream_state;
reg [31:0]       bmp_data_offset;
reg [1:0]        rgb_byte_count;
reg [23:0]       rgb_pixel;

// 第五讲 2.1：BMP 头字段
reg [7:0]        hdr_byte0;
reg [7:0]        hdr_byte1;
reg [31:0]       hdr_file_size;
reg [31:0]       hdr_dib_size;
reg [31:0]       hdr_width;
reg [31:0]       hdr_height;
reg [15:0]       hdr_planes;
reg [15:0]       hdr_bpp;
reg [31:0]       hdr_compression;
reg              hdr_checked;

// 同步 mem_clk 域的 write_finish_toggle
reg [2:0]        wrfin_tgl_sync;
wire             write_finish_pulse;

wire auto_tick;
wire [1:0] next_from_current;
wire [1:0] prev_from_current;
wire [1:0] first_from_valid;

// 第五讲 2.1：BMP 严格校验（官方原有 4 项 + 讲义新增 5 项）
wire hdr_struct_ok;
wire len_ok;
wire header_ok;
// 第五讲 2.5：像素完整性
wire pixel_ok;
// 第五讲 2.4：看门狗
wire wd_progress;
wire wd_active;
wire wd_hit;

// 可播放槽位：目录里存在 且 未判定为坏图
wire [3:0] play_valid;
wire [2:0] play_count;

assign write_en   = bmp_data_wr_en;
assign write_data = {bmp_data[23:16], bmp_data[15:8], bmp_data[7:0], 8'b0};
assign write_req  = write_req_reg;
assign auto_tick  = (auto_cnt >= (AUTO_PLAY_CYCLES - 1));
assign write_finish_pulse = wrfin_tgl_sync[2] ^ wrfin_tgl_sync[1];
assign key_auto_release = (~key_auto_stable_d) & key_auto_stable;

// 第五讲 2.1：严格校验条件（与讲义 2.1 一致）
// 结构类校验：不通过 → ERR_HEADER
assign hdr_struct_ok = (hdr_byte0 == 8'h42) &&                     // 'B'
                  (hdr_byte1 == 8'h4D) &&                      // 'M'
                  (hdr_dib_size >= 32'd40) &&                  // DIB 头大小 >= 40（新增）
                  (hdr_width[15:0]  == bmp_width) &&           // 宽度 = 640
                  (hdr_height[15:0] == bmp_height) &&          // 高度 = 480
                  (hdr_planes == 16'd1) &&                     // 平面数 = 1（新增）
                  (hdr_bpp == 16'd24) &&                       // 位深 = 24
                  (hdr_compression == 32'd0) &&                // 不压缩
                  (bmp_data_offset >= 32'd54) &&               // 像素偏移 >= 54（新增）
                  (bmp_data_offset < load_file_size);          // 像素偏移 < 文件大小（新增）

// 长度类校验：结构合法但装不下像素 → ERR_TRUNCATED（讲义 §2.5 语义）
// 长度同时看两个来源：BMP 头内 file_size（讲义 2.1 的 file_len）
// 与 FAT32 目录项的真实长度（第七讲架构提供，更可靠）
assign len_ok = (hdr_file_size  >= (bmp_data_offset + EXPECTED_BYTES)) &&
                (load_file_size >= (bmp_data_offset + EXPECTED_BYTES));

assign header_ok = hdr_struct_ok && len_ok;

// 头部字段齐备（偏移 0~33 覆盖全部校验字段）后的第一个字节
wire hdr_ready = (bmp_stream_state == 2'd1) && streamer_byte_valid &&
                 (streamer_byte_offset >= 32'd34);
wire hdr_bad = hdr_ready && !hdr_checked && !hdr_struct_ok;          // 结构非法 → ERR_HEADER
wire len_bad = hdr_ready && !hdr_checked &&  hdr_struct_ok && !len_ok; // 长度不足 → ERR_TRUNCATED

assign pixel_ok = (pixel_count >= EXPECTED_PIXELS);

// 第五讲 2.4：只要“有进展”就清零的看门狗（500ms 无进展即判超时）
assign wd_progress = streamer_byte_valid | scanner_sector_valid | streamer_sector_valid |
                     scanner_sector_done  | streamer_sector_done  | write_finish_pulse;
assign wd_active   = (load_busy && !write_finish_seen) || (scan_kicked && !scan_done_latched);
assign wd_hit      = wd_active && (wd_cnt >= (WATCHDOG_CYCLES - 1));

// 第五讲 2.2：源文件读完（像素计数稳定后）的完整性判定
wire err_trunc     = file_done_d1 &&  hdr_checked && !pixel_ok;  // 头合法但像素不足
wire err_hdr_short = file_done_d1 && !hdr_checked;               // 头都没读全

wire err_now  = hdr_bad | len_bad | err_trunc | err_hdr_short | wd_hit;
wire [2:0] err_code_now = (hdr_bad | err_hdr_short) ? ERR_HEADER :
                          (wd_hit ? ERR_TIMEOUT : ERR_TRUNCATED);

key_press_debounce #(
    .CLK_FREQ_HZ (CLK_FREQ_HZ),
    .DEBOUNCE_MS (20)
) u_key_next (
    .clk        (clk),
    .rst        (rst),
    .button_in  (key_next),
    .press_pulse(key_next_press),
    .button_stable_out(key_next_stable)
);

key_press_debounce #(
    .CLK_FREQ_HZ (CLK_FREQ_HZ),
    .DEBOUNCE_MS (20)
) u_key_auto (
    .clk        (clk),
    .rst        (rst),
    .button_in  (key_auto),
    .press_pulse(key_auto_press),
    .button_stable_out(key_auto_stable)
);

// ---------------------------------------------------------------------------
// 槽位（PIC1~PIC4）导航：直接按槽位选图，天然跳过“缺失/坏图”的槽位
// ---------------------------------------------------------------------------
function [1:0] first_slot_ok;
    input [3:0] mask;
    begin
        if (mask[0])      first_slot_ok = 2'd0;
        else if (mask[1]) first_slot_ok = 2'd1;
        else if (mask[2]) first_slot_ok = 2'd2;
        else              first_slot_ok = 2'd3;
    end
endfunction

function [1:0] next_slot_ok;
    input [1:0] cur;
    input [3:0] mask;
    reg [1:0]   s;
    integer     k;
    reg         found;
    begin
        found = 1'b0;
        s     = cur;
        next_slot_ok = cur;
        for (k = 0; k < 4; k = k + 1) begin
            s = s + 2'd1;                       // 2 位自然回绕
            if (!found && mask[s]) begin
                next_slot_ok = s;
                found        = 1'b1;
            end
        end
    end
endfunction

function [1:0] prev_slot_ok;
    input [1:0] cur;
    input [3:0] mask;
    reg [1:0]   s;
    integer     k;
    reg         found;
    begin
        found = 1'b0;
        s     = cur;
        prev_slot_ok = cur;
        for (k = 0; k < 4; k = k + 1) begin
            s = s - 2'd1;                       // 2 位自然回绕
            if (!found && mask[s]) begin
                prev_slot_ok = s;
                found        = 1'b1;
            end
        end
    end
endfunction

function [2:0] count_slots;
    input [3:0] mask;
    begin
        count_slots = {2'd0, mask[0]} + {2'd0, mask[1]} +
                      {2'd0, mask[2]} + {2'd0, mask[3]};
    end
endfunction

function [31:0] cluster_of;
    input [1:0] slot;
    begin
        case (slot)
            2'd0:    cluster_of = img_cluster0;
            2'd1:    cluster_of = img_cluster1;
            2'd2:    cluster_of = img_cluster2;
            default: cluster_of = img_cluster3;
        endcase
    end
endfunction

function [31:0] size_of;
    input [1:0] slot;
    begin
        case (slot)
            2'd0:    size_of = img_size0;
            2'd1:    size_of = img_size1;
            2'd2:    size_of = img_size2;
            default: size_of = img_size3;
        endcase
    end
endfunction

function [1:0] next_buf_lut;
    input [1:0] cur_disp_buf;
    input       valid_now;
    begin
        if (!valid_now)
            next_buf_lut = 2'd0;                 // 首图固定写 buffer0
        else if (cur_disp_buf == 2'd0)
            next_buf_lut = 2'd1;
        else
            next_buf_lut = 2'd0;
    end
endfunction

// 槽位导航信号（函数定义之后调用）
assign play_valid = scan_resource_valid & ~img_bad;
assign play_count = count_slots(play_valid);

assign next_from_current = next_slot_ok(img_idx, play_valid);
assign prev_from_current = prev_slot_ok(img_idx, play_valid);
assign first_from_valid  = first_slot_ok(play_valid);

always @(posedge clk or posedge rst) begin
    if (rst) begin
        wrfin_tgl_sync        <= 3'b000;
        scan_start_pulse      <= 1'b0;
        load_start_pulse      <= 1'b0;
        scan_kicked           <= 1'b0;
        scan_done_latched     <= 1'b0;
        use_streamer          <= 1'b0;
        first_image_committed <= 1'b0;
        auto_play_en          <= 1'b0;
        auto_cnt              <= 32'd0;
        img_idx               <= 2'd0;
        load_idx              <= 2'd0;
        pending_buf_idx       <= 2'd0;
        write_buf_idx         <= 2'd0;
        disp_buf_idx          <= 2'd0;
        img_cluster0          <= 32'd0;
        img_cluster1          <= 32'd0;
        img_cluster2          <= 32'd0;
        img_cluster3          <= 32'd0;
        img_size0             <= 32'd0;
        img_size1             <= 32'd0;
        img_size2             <= 32'd0;
        img_size3             <= 32'd0;
        load_cluster          <= 32'd0;
        load_file_size        <= 32'd0;
        next_req_pending      <= 1'b0;
        prev_req_pending      <= 1'b0;
        load_busy             <= 1'b0;
        write_finish_seen     <= 1'b0;
        key_auto_stable_d     <= 1'b1;
        long_press_cnt        <= 32'd0;
        long_press_marked     <= 1'b0;
        source_done_seen      <= 1'b0;
        display_valid         <= 1'b0;
        state_code            <= 4'd0;
        img_bad               <= 4'd0;
        retry_count           <= 2'd0;
        retry_pending         <= 1'b0;
        skip_pending          <= 1'b0;
        load_abort            <= 1'b0;
        bmp_error             <= ERR_NONE;
        load_error            <= 1'b0;
        err_latched           <= 1'b0;
        pixel_count           <= 32'd0;
        wd_cnt                <= 32'd0;
        wd_latched            <= 1'b0;
        file_done_d1          <= 1'b0;
    end else begin
        wrfin_tgl_sync    <= {wrfin_tgl_sync[1:0], write_finish_toggle};
        scan_start_pulse  <= 1'b0;
        load_start_pulse  <= 1'b0;
        load_error        <= 1'b0;                 // 第五讲 2.2：单周期脉冲
        key_auto_stable_d <= key_auto_stable;
        file_done_d1      <= load_busy & file_done;
        // 正常显示图片编号（PIC 编号）；有未清除的错误时显示 8|错误码
        state_code        <= err_latched ? (4'h8 | {1'b0, bmp_error})
                                         : ({2'b0, img_idx} + 4'd1);

        // 第五讲 2.4：无进展计时（有进展即清零）
        if (!wd_active || wd_progress)
            wd_cnt <= 32'd0;
        else if (!wd_hit)
            wd_cnt <= wd_cnt + 32'd1;

        if (wd_hit)
            wd_latched <= 1'b1;

        if (!sd_init_done) begin
            state_code            <= 4'd0;
            scan_kicked           <= 1'b0;
            first_image_committed <= 1'b0;
            auto_play_en          <= 1'b0;
            auto_cnt              <= 32'd0;
            img_idx               <= 2'd0;
            load_idx              <= 2'd0;
            pending_buf_idx       <= 2'd0;
            write_buf_idx         <= 2'd0;
            disp_buf_idx          <= 2'd0;
            img_cluster0          <= 32'd0;
            img_cluster1          <= 32'd0;
            img_cluster2          <= 32'd0;
            img_cluster3          <= 32'd0;
            img_size0             <= 32'd0;
            img_size1             <= 32'd0;
            img_size2             <= 32'd0;
            img_size3             <= 32'd0;
            load_cluster          <= 32'd0;
            load_file_size        <= 32'd0;
            next_req_pending      <= 1'b0;
            prev_req_pending      <= 1'b0;
            load_busy             <= 1'b0;
            write_finish_seen     <= 1'b0;
            key_auto_stable_d     <= 1'b1;
            long_press_cnt        <= 32'd0;
            long_press_marked     <= 1'b0;
            source_done_seen      <= 1'b0;
            display_valid         <= 1'b0;
            scan_done_latched     <= 1'b0;
            use_streamer          <= 1'b0;
            img_bad               <= 4'd0;
            retry_count           <= 2'd0;
            retry_pending         <= 1'b0;
            skip_pending          <= 1'b0;
            load_abort            <= 1'b0;
            bmp_error             <= ERR_NONE;
            err_latched           <= 1'b0;
            pixel_count           <= 32'd0;
            wd_cnt                <= 32'd0;
            wd_latched            <= 1'b0;
        end else begin
            // 扫描完成时一次性锁存四个目录项的簇号和文件大小。
            if (scanner_done_pulse) begin
                scan_done_latched <= 1'b1;
                use_streamer      <= (scan_resource_valid != 4'd0);
                img_cluster0      <= scanner_cluster0;
                img_cluster1      <= scanner_cluster1;
                img_cluster2      <= scanner_cluster2;
                img_cluster3      <= scanner_cluster3;
                img_size0         <= scanner_size0;
                img_size1         <= scanner_size1;
                img_size2         <= scanner_size2;
                img_size3         <= scanner_size3;
                // 第五讲 2.2：一张都没找到时也给出可观测的错误码，
                // 并按扫描器 fs_error 区分“卷不认识”与“根目录没有图”，便于现场定位
                if (scan_resource_valid == 4'd0) begin
                    if (scanner_fs_error == 8'h10)
                        bmp_error <= ERR_SD_SECTOR;   // 扇区读失败 → E
                    else if (scanner_fs_error == 8'h22)
                        bmp_error <= ERR_NO_IMAGE;    // 根目录没有 PICn.BMP → C
                    else
                        bmp_error <= ERR_FS;          // MBR/BPB 不认识 → D
                    err_latched <= 1'b1;
                end
            end

            // 记住 bmp_read 已经把源图送完 FIFO，但还不能切显示，得等整帧写完
            if (load_busy && file_done)
                source_done_seen <= 1'b1;

            // 完成脉冲只持续一个 sd_card_clk 周期，先暂存它，避免和
            // 源图完成同周期到达时被非阻塞赋值的旧值语义漏掉。
            if (load_busy && write_finish_pulse)
                write_finish_seen <= 1'b1;

            // 第五讲 2.5：统计实际写入 FIFO 的像素数
            if (load_busy && bmp_data_wr_en)
                pixel_count <= pixel_count + 32'd1;

            // 第五讲 2.2：错误判定（头部非法 / 像素不足 / 无进展超时）
            if (load_busy && !load_abort && err_now) begin
                load_abort  <= 1'b1;
                bmp_error   <= err_code_now;
                load_error  <= 1'b1;
                err_latched <= 1'b1;
            end else if (!load_busy && wd_hit && scan_kicked && !scan_done_latched) begin
                // 扫描阶段卡住：只上报错误码（SD 底层控制器不在本文件可恢复范围内）
                bmp_error   <= ERR_TIMEOUT;
                load_error  <= 1'b1;
                err_latched <= 1'b1;
            end

            // 第五讲 2.2：恢复阶梯——重试 1 次 → 屏蔽坏图 → 切下一张可用图
            if (load_busy && load_abort && (source_done_seen || file_done || wd_latched)) begin
                load_busy  <= 1'b0;
                load_abort <= 1'b0;
                wd_latched <= 1'b0;
                wd_cnt     <= 32'd0;
                source_done_seen  <= 1'b0;
                write_finish_seen <= 1'b0;
                if (retry_count < MAX_RETRIES) begin
                    retry_count   <= retry_count + 2'd1;
                    retry_pending <= 1'b1;
                end else begin
                    img_bad[load_idx] <= 1'b1;
                    skip_pending      <= 1'b1;
                end
            end

            // 正常提交：只有“源图送完 + 整帧写完 + 像素数完整”才切显示缓冲区。
            // 允许两个条件在同一拍到达，也允许完成脉冲先到达。
            if (load_busy && !load_abort && pixel_ok &&
                (source_done_seen || file_done) &&
                (write_finish_seen || write_finish_pulse)) begin
                load_busy             <= 1'b0;
                source_done_seen      <= 1'b0;
                write_finish_seen     <= 1'b0;
                retry_count           <= 2'd0;
                retry_pending         <= 1'b0;
                skip_pending          <= 1'b0;
                err_latched           <= 1'b0;
                bmp_error             <= ERR_NONE;
                wd_latched            <= 1'b0;
                disp_buf_idx          <= pending_buf_idx;
                img_idx               <= load_idx;
                display_valid         <= 1'b1;
                first_image_committed <= 1'b1;
            end

            // 上电后自动发起一次“扫描前 4 张 BMP”
            if (!scan_kicked && sd_init_done && sdram_init_done) begin
                scan_start_pulse      <= 1'b1;
                scan_kicked           <= 1'b1;
                first_image_committed <= 1'b0;
                auto_play_en          <= 1'b0;
                auto_cnt              <= 32'd0;
                img_idx               <= 2'd0;
                load_idx              <= 2'd0;
                pending_buf_idx       <= 2'd0;
                write_buf_idx         <= 2'd0;
                disp_buf_idx          <= 2'd0;
                next_req_pending      <= 1'b0;
                prev_req_pending      <= 1'b0;
                display_valid         <= 1'b0;
                load_busy             <= 1'b0;
                source_done_seen      <= 1'b0;
                write_finish_seen     <= 1'b0;
                img_bad               <= 4'd0;
                retry_count           <= 2'd0;
                retry_pending         <= 1'b0;
                skip_pending          <= 1'b0;
                load_abort            <= 1'b0;
                bmp_error             <= ERR_NONE;
                err_latched           <= 1'b0;
                pixel_count           <= 32'd0;
                wd_cnt                <= 32'd0;
                wd_latched            <= 1'b0;
            end else begin
                // KEY2长按检测：按住达到阈值只挂起一次上一张请求。
                if (key_auto_stable == 1'b0) begin
                    if (long_press_cnt < (LONG_PRESS_CYCLES - 1)) begin
                        long_press_cnt <= long_press_cnt + 32'd1;
                    end else if (!long_press_marked) begin
                        long_press_marked <= 1'b1;
                        if (scan_done && (play_count > 3'd0))
                            prev_req_pending <= 1'b1;
                    end
                end else begin
                    long_press_cnt    <= 32'd0;
                    long_press_marked <= 1'b0;
                end

                // 忙的时候也只记 1 次“下一张”请求，不会累积成连跳两张
                if (key_next_press && scan_done && (play_count > 3'd0))
                    next_req_pending <= 1'b1;

                // 自动播放计时：只有当前没有写图任务时才计时。
                if (scan_done && auto_play_en && display_valid && !load_busy && first_image_committed && (play_count > 3'd1)) begin
                    if (auto_tick)
                        auto_cnt <= 32'd0;
                    else
                        auto_cnt <= auto_cnt + 32'd1;
                end else begin
                    auto_cnt <= 32'd0;
                end

                // KEY2短按在消抖后的释放沿切换自动播放；长按释放不触发短按。
                if (key_auto_release && !long_press_marked && scan_done && (play_count > 3'd1)) begin
                    auto_play_en <= ~auto_play_en;
                    auto_cnt     <= 32'd0;
                end

                // 加载优先级：重试 → 跳过坏图 → 首图 → 下一张 → 上一张 → 自动
                // 统一门控 !streamer_busy：源文件流未结束前不启动下一次加载，
                // 避免上一张的残留字节被当成新图数据（第五讲 2.2 恢复路径的安全前提）
                if (scan_done && !load_busy && !streamer_busy && retry_pending && (play_count != 3'd0)) begin
                    // 第五讲 2.2：同一张图重试
                    load_cluster     <= cluster_of(load_idx);
                    load_file_size   <= size_of(load_idx);
                    pending_buf_idx  <= next_buf_lut(disp_buf_idx, display_valid);
                    write_buf_idx    <= next_buf_lut(disp_buf_idx, display_valid);
                    load_start_pulse <= 1'b1;
                    load_busy        <= 1'b1;
                    retry_pending    <= 1'b0;
                    source_done_seen <= 1'b0;
                    write_finish_seen<= 1'b0;
                    pixel_count      <= 32'd0;
                    load_abort       <= 1'b0;
                    wd_cnt           <= 32'd0;
                    wd_latched       <= 1'b0;
                    next_req_pending <= 1'b0;
                    prev_req_pending <= 1'b0;
                    auto_cnt         <= 32'd0;
                end
                // 第五讲 2.3/2.2：坏图跳过，切到下一张可用图（不提交、保留上一帧）
                else if (scan_done && !load_busy && !streamer_busy && skip_pending && (play_count != 3'd0)) begin
                    load_idx         <= next_from_current;
                    load_cluster     <= cluster_of(next_from_current);
                    load_file_size   <= size_of(next_from_current);
                    pending_buf_idx  <= next_buf_lut(disp_buf_idx, display_valid);
                    write_buf_idx    <= next_buf_lut(disp_buf_idx, display_valid);
                    load_start_pulse <= 1'b1;
                    load_busy        <= 1'b1;
                    skip_pending     <= 1'b0;
                    source_done_seen <= 1'b0;
                    write_finish_seen<= 1'b0;
                    pixel_count      <= 32'd0;
                    load_abort       <= 1'b0;
                    wd_cnt           <= 32'd0;
                    wd_latched       <= 1'b0;
                    next_req_pending <= 1'b0;
                    prev_req_pending <= 1'b0;
                    auto_cnt         <= 32'd0;
                end
                // 首图自动加载到 buffer0
                else if (scan_done && !first_image_committed && !load_busy && !streamer_busy && (play_count != 3'd0)) begin
                    load_idx         <= first_from_valid;
                    load_cluster     <= cluster_of(first_from_valid);
                    load_file_size   <= size_of(first_from_valid);
                    pending_buf_idx  <= 2'd0;
                    write_buf_idx    <= 2'd0;
                    load_start_pulse <= 1'b1;
                    load_busy        <= 1'b1;
                    source_done_seen <= 1'b0;
                    write_finish_seen <= 1'b0;
                    pixel_count      <= 32'd0;
                    load_abort       <= 1'b0;
                    wd_cnt           <= 32'd0;
                    wd_latched       <= 1'b0;
                    next_req_pending <= 1'b0;
                    prev_req_pending <= 1'b0;
                    auto_cnt         <= 32'd0;
                end
                // 手动下一张优先：写到“非当前显示”的另一块 buffer
                else if (scan_done && display_valid && !load_busy && !streamer_busy && next_req_pending && (play_count != 3'd0)) begin
                    load_idx         <= next_from_current;
                    load_cluster     <= cluster_of(next_from_current);
                    load_file_size   <= size_of(next_from_current);
                    pending_buf_idx  <= next_buf_lut(disp_buf_idx, display_valid);
                    write_buf_idx    <= next_buf_lut(disp_buf_idx, display_valid);
                    load_start_pulse <= 1'b1;
                    load_busy        <= 1'b1;
                    source_done_seen <= 1'b0;
                    write_finish_seen <= 1'b0;
                    pixel_count      <= 32'd0;
                    load_abort       <= 1'b0;
                    wd_cnt           <= 32'd0;
                    wd_latched       <= 1'b0;
                    next_req_pending <= 1'b0;
                    auto_cnt         <= 32'd0;
                end
                // 长按上一张：下一张请求优先，仍然写到“非当前显示”的另一块 buffer
                else if (scan_done && display_valid && !load_busy && !streamer_busy && prev_req_pending && (play_count != 3'd0)) begin
                    load_idx         <= prev_from_current;
                    load_cluster     <= cluster_of(prev_from_current);
                    load_file_size   <= size_of(prev_from_current);
                    pending_buf_idx  <= next_buf_lut(disp_buf_idx, display_valid);
                    write_buf_idx    <= next_buf_lut(disp_buf_idx, display_valid);
                    load_start_pulse <= 1'b1;
                    load_busy        <= 1'b1;
                    source_done_seen <= 1'b0;
                    write_finish_seen <= 1'b0;
                    pixel_count      <= 32'd0;
                    load_abort       <= 1'b0;
                    wd_cnt           <= 32'd0;
                    wd_latched       <= 1'b0;
                    prev_req_pending <= 1'b0;
                    auto_cnt         <= 32'd0;
                end
                // 自动播放下一张：同样写到“非当前显示”的另一块 buffer
                else if (scan_done && display_valid && !load_busy && !streamer_busy && auto_play_en && auto_tick && !key_auto_release && (play_count > 3'd1)) begin
                    load_idx         <= next_from_current;
                    load_cluster     <= cluster_of(next_from_current);
                    load_file_size   <= size_of(next_from_current);
                    pending_buf_idx  <= next_buf_lut(disp_buf_idx, display_valid);
                    write_buf_idx    <= next_buf_lut(disp_buf_idx, display_valid);
                    load_start_pulse <= 1'b1;
                    load_busy        <= 1'b1;
                    source_done_seen <= 1'b0;
                    write_finish_seen <= 1'b0;
                    pixel_count      <= 32'd0;
                    load_abort       <= 1'b0;
                    wd_cnt           <= 32'd0;
                    wd_latched       <= 1'b0;
                    auto_cnt         <= 32'd0;
                end
            end
        end
    end
end

// FAT32 scanner and file streamer share one physical SD sector reader.
always @(*) begin
    if (use_streamer) begin
        arb_sector_req = streamer_sector_req;
        arb_sector_lba = streamer_sector_lba;
    end else begin
        arb_sector_req = scanner_sector_req;
        arb_sector_lba = scanner_sector_lba;
    end
end

assign scanner_sector_busy       = use_streamer ? 1'b0            : arb_sector_busy;
assign scanner_sector_valid      = use_streamer ? 1'b0            : arb_sector_valid;
assign scanner_sector_byte       = use_streamer ? 8'd0           : arb_sector_byte;
assign scanner_sector_byte_index = use_streamer ? 9'd0           : arb_sector_byte_index;
assign scanner_sector_done       = use_streamer ? 1'b0            : arb_sector_done;
assign scanner_sector_error      = use_streamer ? 8'd0            : arb_sector_error;
assign streamer_sector_busy      = use_streamer ? arb_sector_busy : 1'b0;
assign streamer_sector_valid     = use_streamer ? arb_sector_valid : 1'b0;
assign streamer_sector_byte      = use_streamer ? arb_sector_byte : 8'd0;
assign streamer_sector_byte_index= use_streamer ? arb_sector_byte_index : 9'd0;
assign streamer_sector_done      = use_streamer ? arb_sector_done : 1'b0;
assign streamer_sector_error     = use_streamer ? arb_sector_error : 8'd0;

fat32_volume_scanner u_scanner (
    .clk                 (clk),
    .rst_n               (~rst),
    .scan_start          (scan_start_pulse),
    .scan_busy           (),
    .scan_done           (scanner_done_pulse),
    .fs_error            (scanner_fs_error),
    .partition_lba       (),
    .sectors_per_cluster (scanner_spc),
    .fat_start_lba       (scanner_fat_start),
    .data_start_lba      (scanner_data_start),
    .max_cluster         (scanner_max_cluster),
    .resource_valid      (scan_resource_valid),
    .resource0_cluster   (scanner_cluster0),
    .resource1_cluster   (scanner_cluster1),
    .resource2_cluster   (scanner_cluster2),
    .resource3_cluster   (scanner_cluster3),
    .resource0_size      (scanner_size0),
    .resource1_size      (scanner_size1),
    .resource2_size      (scanner_size2),
    .resource3_size      (scanner_size3),
    .sector_req          (scanner_sector_req),
    .sector_lba          (scanner_sector_lba),
    .sector_busy         (scanner_sector_busy),
    .sector_valid        (scanner_sector_valid),
    .sector_byte         (scanner_sector_byte),
    .sector_byte_index   (scanner_sector_byte_index),
    .sector_done         (scanner_sector_done),
    .sector_error        (scanner_sector_error)
);

fat32_file_streamer u_streamer (
    .clk                 (clk),
    .rst_n               (~rst),
    .file_start          (file_start_pulse),
    .first_cluster       (load_cluster),
    .file_size           (load_file_size),
    .sectors_per_cluster (scanner_spc),
    .fat_start_lba       (scanner_fat_start),
    .data_start_lba      (scanner_data_start),
    .max_cluster         (scanner_max_cluster),
    .file_busy           (streamer_busy),
    .file_done           (file_done),
    .file_valid          (streamer_byte_valid),
    .file_byte           (streamer_byte),
    .file_byte_offset    (streamer_byte_offset),
    .fs_error            (streamer_fs_error),
    .sector_req          (streamer_sector_req),
    .sector_lba          (streamer_sector_lba),
    .sector_busy         (streamer_sector_busy),
    .sector_valid        (streamer_sector_valid),
    .sector_byte         (streamer_sector_byte),
    .sector_byte_index   (streamer_sector_byte_index),
    .sector_done         (streamer_sector_done),
    .sector_error        (streamer_sector_error)
);

sd_sector_adapter u_adapter (
    .clk                    (clk),
    .rst_n                  (~rst),
    .sector_req             (arb_sector_req),
    .sector_lba             (arb_sector_lba),
    .sector_busy            (arb_sector_busy),
    .sector_valid           (arb_sector_valid),
    .sector_byte            (arb_sector_byte),
    .sector_byte_index      (arb_sector_byte_index),
    .sector_done            (arb_sector_done),
    .sector_error           (arb_sector_error),
    .sd_sec_read            (sd_sec_read),
    .sd_sec_read_addr       (sd_sec_read_addr),
    .sd_sec_read_data_valid (sd_sec_read_data_valid),
    .sd_sec_read_data       (sd_sec_read_data),
    .sd_sec_read_end        (sd_sec_read_end)
);

// 第五讲 2.5：像素数达到 EXPECTED_PIXELS 后不再写 FIFO，避免超出帧长度
assign bmp_data_wr_en = streamer_byte_valid &&
                         (bmp_stream_state == 2'd2) &&
                         (rgb_byte_count == 2'd2) &&
                         (pixel_count < EXPECTED_PIXELS);
assign bmp_data = {streamer_byte, rgb_pixel[15:0]};

// The FIFO request is acknowledged before starting the streamer, preserving
// the original SD-to-SDRAM handshake timing.
always @(posedge clk or posedge rst) begin
    if (rst) begin
        file_start_pulse <= 1'b0;
        write_req_reg    <= 1'b0;
    end else begin
        file_start_pulse <= 1'b0;
        if (load_start_pulse)
            write_req_reg <= 1'b1;
        if (write_req_reg && write_req_ack) begin
            write_req_reg    <= 1'b0;
            file_start_pulse <= 1'b1;
        end
    end
end

// ---------------------------------------------------------------------------
// 第五讲 2.1：BMP 头字段解析（严格校验用）+ BGR 到 RGB 拼装（第七讲 5.4）
// ---------------------------------------------------------------------------
always @(posedge clk or posedge rst) begin
    if (rst) begin
        bmp_stream_state  <= 2'd0;
        bmp_data_offset   <= 32'd54;
        hdr_byte0         <= 8'd0;
        hdr_byte1         <= 8'd0;
        hdr_file_size     <= 32'd0;
        hdr_dib_size      <= 32'd0;
        hdr_width         <= 32'd0;
        hdr_height        <= 32'd0;
        hdr_planes        <= 16'd0;
        hdr_bpp           <= 16'd0;
        hdr_compression   <= 32'd0;
        hdr_checked       <= 1'b0;
        rgb_byte_count    <= 2'd0;
        rgb_pixel         <= 24'd0;
    end else if (file_start_pulse) begin
        bmp_stream_state  <= 2'd1;
        bmp_data_offset   <= 32'd54;
        hdr_byte0         <= 8'd0;
        hdr_byte1         <= 8'd0;
        hdr_file_size     <= 32'd0;
        hdr_dib_size      <= 32'd0;
        hdr_width         <= 32'd0;
        hdr_height        <= 32'd0;
        hdr_planes        <= 16'd0;
        hdr_bpp           <= 16'd0;
        hdr_compression   <= 32'd0;
        hdr_checked       <= 1'b0;
        rgb_byte_count    <= 2'd0;
        rgb_pixel         <= 24'd0;
    end else if (file_done) begin
        bmp_stream_state  <= 2'd0;
    end else if (streamer_byte_valid) begin
        if (bmp_stream_state == 2'd1) begin
            case (streamer_byte_offset)
                32'd0 : hdr_byte0 <= streamer_byte;
                32'd1 : hdr_byte1 <= streamer_byte;
                32'd2 : hdr_file_size[7:0]     <= streamer_byte;
                32'd3 : hdr_file_size[15:8]    <= streamer_byte;
                32'd4 : hdr_file_size[23:16]   <= streamer_byte;
                32'd5 : hdr_file_size[31:24]   <= streamer_byte;
                32'd10: bmp_data_offset[7:0]   <= streamer_byte;
                32'd11: bmp_data_offset[15:8]  <= streamer_byte;
                32'd12: bmp_data_offset[23:16] <= streamer_byte;
                32'd13: bmp_data_offset[31:24] <= streamer_byte;
                32'd14: hdr_dib_size[7:0]      <= streamer_byte;
                32'd15: hdr_dib_size[15:8]     <= streamer_byte;
                32'd16: hdr_dib_size[23:16]    <= streamer_byte;
                32'd17: hdr_dib_size[31:24]    <= streamer_byte;
                32'd18: hdr_width[7:0]         <= streamer_byte;
                32'd19: hdr_width[15:8]        <= streamer_byte;
                32'd20: hdr_width[23:16]       <= streamer_byte;
                32'd21: hdr_width[31:24]       <= streamer_byte;
                32'd22: hdr_height[7:0]        <= streamer_byte;
                32'd23: hdr_height[15:8]       <= streamer_byte;
                32'd24: hdr_height[23:16]      <= streamer_byte;
                32'd25: hdr_height[31:24]      <= streamer_byte;
                32'd26: hdr_planes[7:0]        <= streamer_byte;
                32'd27: hdr_planes[15:8]       <= streamer_byte;
                32'd28: hdr_bpp[7:0]           <= streamer_byte;
                32'd29: hdr_bpp[15:8]          <= streamer_byte;
                32'd30: hdr_compression[7:0]   <= streamer_byte;
                32'd31: hdr_compression[15:8]  <= streamer_byte;
                32'd32: hdr_compression[23:16] <= streamer_byte;
                32'd33: hdr_compression[31:24] <= streamer_byte;
                default: ;
            endcase
            // 偏移 34 起全部校验字段已锁存，可以判定头部合法性
            if (streamer_byte_offset >= 32'd34)
                hdr_checked <= 1'b1;
            if (header_ok && hdr_checked &&
                (streamer_byte_offset + 32'd1 >= bmp_data_offset)) begin
                bmp_stream_state <= 2'd2;
                rgb_byte_count   <= 2'd0;
            end
        end else if (bmp_stream_state == 2'd2) begin
            case (rgb_byte_count)
                2'd0: begin
                    rgb_pixel[7:0]  <= streamer_byte;
                    rgb_byte_count   <= 2'd1;
                end
                2'd1: begin
                    rgb_pixel[15:8] <= streamer_byte;
                    rgb_byte_count   <= 2'd2;
                end
                default: begin
                    rgb_pixel[23:16] <= streamer_byte;
                    rgb_byte_count    <= 2'd0;
                end
            endcase
        end
    end
end

sd_card_top sd_card_top_m0(
    .clk                    (clk),
    .rst                    (rst),
    .SD_nCS                 (SD_nCS),
    .SD_DCLK                (SD_DCLK),
    .SD_MOSI                (SD_MOSI),
    .SD_MISO                (SD_MISO),
    .sd_init_done           (sd_init_done),
    .sd_sec_read            (sd_sec_read),
    .sd_sec_read_addr       (sd_sec_read_addr),
    .sd_sec_read_data       (sd_sec_read_data),
    .sd_sec_read_data_valid (sd_sec_read_data_valid),
    .sd_sec_read_end        (sd_sec_read_end),
